@model IEnumerable<Proyecto_CPS.Models.Cliente>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.PrimNombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SegNombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ApellidoP)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ApellidoM)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Telefono)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Correo)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.PrimNombre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.SegNombre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ApellidoP)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ApellidoM)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Telefono)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Correo)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdCliente">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.IdCliente">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.IdCliente">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
