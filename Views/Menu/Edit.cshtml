@model Proyecto_CPS.Models.Menu

@{
    ViewData["Title"] = "Editar Platillo";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-warning text-dark">
                    <h3 class="mb-0">
                        <i class="fas fa-edit me-2"></i>
                        Editar Platillo
                    </h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="IdMenu" />

                        <!-- Nombre -->
                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label">
                                <i class="fas fa-utensils me-1"></i>
                                Nombre del Platillo <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Nombre" class="form-control form-control-lg" required
                                   pattern="[A-Za-zÁÉÍÓÚáéíóúÑñ ]+"
                                   title="Solo se permiten letras y espacios"
                                   oninput="this.value = this.value.replace(/[^A-Za-zÁÉÍÓÚáéíóúÑñ ]/g,'')" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <!-- Categoría -->
                        <div class="mb-3">
                            <label asp-for="CategoriaMenuId" class="form-label">
                                <i class="fas fa-list me-1"></i>
                                Categoría <span class="text-danger">*</span>
                            </label>
                            <select asp-for="CategoriaMenuId" class="form-select form-select-lg" asp-items="ViewBag.Categorias" required>
                                <option value="">-- Selecciona una categoría --</option>
                            </select>
                            <span asp-validation-for="CategoriaMenuId" class="text-danger"></span>
                        </div>

                        <!-- Precio -->
                        <div class="mb-3">
                            <label asp-for="Precio" class="form-label">
                                <i class="fas fa-dollar-sign me-1"></i>
                                Precio (S/.) <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Precio" type="number" step="0.01" min="0" class="form-control form-control-lg" required />
                            <span asp-validation-for="Precio" class="text-danger"></span>
                        </div>

                        <!-- Descripción -->
                        <div class="mb-3">
                            <label asp-for="Descripcion" class="form-label">
                                <i class="fas fa-align-left me-1"></i>
                                Descripción <span class="text-danger">*</span>
                            </label>
                            <textarea asp-for="Descripcion" class="form-control" rows="4" required></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                        </div>

                        <!-- Imagen URL -->
                        <div class="mb-3">
                            <label asp-for="ImagenUrl" class="form-label">
                                <i class="fas fa-image me-1"></i>
                                URL de Imagen <span class="text-danger">*</span>
                            </label>
                            <input asp-for="ImagenUrl" class="form-control form-control-lg"
                                   placeholder="https://example.com/imagen.jpg"
                                   pattern="https?://.+"
                                   required />
                            <span asp-validation-for="ImagenUrl" class="text-danger"></span>

                            @* Vista previa de la imagen *@
                            @if (!string.IsNullOrEmpty(Model.ImagenUrl))
                            {
                                <div class="mt-3 text-center">
                                    <img src="@Model.ImagenUrl" alt="Vista previa" class="img-fluid rounded"
                                         style="max-height:200px; object-fit:cover; border:1px solid #ccc;" />
                                </div>
                            }
                        </div>

                        <!-- Botones -->
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning btn-lg">
                                <i class="fas fa-save me-2"></i>Guardar Cambios
                            </button>
                            <a asp-action="Admin" class="btn btn-outline-secondary btn-lg">
                                <i class="fas fa-times me-2"></i>Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

