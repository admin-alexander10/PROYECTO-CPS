@{
    ViewData["Title"] = "Inicio";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto">
                <h1 class="display-4 mb-4">Bienvenido a Restaurante Campestre EL PUQUIO</h1>
                <p class="lead mb-4">Experiencia gastronómica única con los mejores sabores de la región</p>
                @if (Context.Session.GetString("Email") == null)
                {
                    <a href="@Url.Action("Login", "Acceso")" class="btn btn-warning btn-lg">
                        <i class="fas fa-sign-in-alt me-2"></i>Acceder al Sistema
                    </a>
                }
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="py-5">
    <div class="container">
        @if (Context.Session.GetString("Email") != null)
        {
            <!-- Dashboard para usuarios logueados -->
            <div class="row mb-5">
                <div class="col-12">
                    <h2 class="text-center mb-4">Panel de Control</h2>
                    <div class="alert alert-success">
                        <h4><i class="fas fa-user me-2"></i>Bienvenido, @Context.Session.GetString("Nombre")!</h4>
                        <p class="text-muted">Gracias por elejirnos y es momento de disfrutar de todos nuestros servicios</p>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="card feature-card h-100">
                    <div class="card-body text-center p-4">
                        <i class="fas fa-utensils fa-3x text-primary mb-3"></i>
                        <h5 class="card-title">
                            <a href="@Url.Action("Index", "Menu")" class="stretched-link text-decoration-none text-dark">Ver Menú</a>
                        </h5>
                        <p class="card-text">Consulta todos los platillos disponibles en nuestro menú.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="card feature-card h-100">
                    <div class="card-body text-center p-4">
                        <i class="fas fa-calendar-plus fa-3x text-success mb-3"></i>
                        <h5 class="card-title">
                            <a href="@Url.Action("Index", "Reserva")" class="stretched-link text-decoration-none text-dark">Generar Reserva</a>
                        </h5>
                        <p class="card-text">Crea una reserva para asegurar tu mesa en El Puquio.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="card feature-card h-100">
                    <div class="card-body text-center p-4">
                        <i class="fas fa-map-marker-alt fa-3x text-info mb-3"></i>
                        <h5 class="card-title">Ubicación</h5>
                        <p class="card-text">Encuéntranos en el mapa y obtén indicaciones para llegar.</p>
                        <!-- Pequeña vista previa del mapa -->
                        <div class="mt-3">
                            <iframe width="100%"
                                    height="200"
                                    style="border:0;"
                                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d463.5859838550163!2d-78.380169218896!3d-7.244824411908038!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x91b2417f5cb54ab5%3A0x20723867fcbc3fb1!2sCentro%20Turistico%20El%20Puquio!5e1!3m2!1ses!2spe!4v1777390874092!5m2!1ses!2spe"
                                    allowfullscreen=""
                                    loading="lazy"
                                    referrerpolicy="no-referrer-when-downgrade">
                            </iframe>

                            <div>
                                <a href="https://maps.google.com/?q=Centro+Turistico+El+Puquio+Cajamarca"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="btn btn-sm btn-primary mt-2">
                                    Abrir en Google Maps
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Información del Restaurante -->
        <div class="row mt-5">
            <div class="col-lg-6">
                <h3>Nuestros Horarios</h3>
                <ul class="list-group">
                    <li class="list-group-item">Lunes a Viernes: 8:00 AM - 17:00 PM</li>
                    <li class="list-group-item">Sábados: 9:00 AM - 17:00 PM</li>
                    <li class="list-group-item">Domingos: 9:00 AM - 17:00 PM</li>
                </ul>
            </div>
            <div class="col-lg-6">
                <h3>Contacto</h3>
                <div class="card">
                    <div class="card-body">
                        <p><i class="fas fa-map-marker-alt me-2"></i> Tayán #360, Jesús-Cajamarca</p>
                        <p><i class="fas fa-phone me-2"></i> <a href="https://wa.me/51937350530?text=Hola%2C%20que%20tal%2C%20quisiera%20realizar%20una%20reserva." target="_blank" rel="noopener noreferrer">+51 937 350 530</a></p>
                        <p><i class="fas fa-envelope me-2"></i> <a href="https://mail.google.com/mail/?view=cm&fs=1&to=dyalvaa30@gmail.com&body=Hola%2C%20que%20tal%2C%20quisiera%20realizar%20una%20reserva." target="_blank" rel="noopener noreferrer">dyalvaa30@gmail.com</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>